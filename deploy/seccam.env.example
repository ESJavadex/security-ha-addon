# /etc/seccam/seccam.env  (root:seccamd 640). Same options as the HA add-on.
# Local relay (seccam-stream + seccam-hls); before 15-oct it was the Pi add-on
STREAM_URL=http://127.0.0.1:8080/stream.m3u8
# Copy the relay's own HLS segments into recordings (exact, no second ffmpeg)
RECORDING_MODE=hls_follow
MOTION_THRESHOLD=5000
MOTION_MIN_DURATION=5
MOTION_COOLDOWN=10
ROI_X_START=0
ROI_X_END=100
ROI_Y_START=5
ROI_Y_END=85
RECORDING_PRE_ROLL=10
RECORDING_POST_ROLL=0
# Recordings live on the WD of minipc32, mounted over SMB at the same path HA uses.
RECORDINGS_PATH=/share/security_recordings
MAX_RECORDINGS=2000
STATE_FILE=/var/lib/seccam/security_state.json
SETTINGS_FILE=/var/lib/seccam/security_settings.json
HTTP_PORT=8081
LOG_LEVEL=info
LLM_ENABLED=false
LLM_AUTO_ANALYZE=false
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=llava
LLM_TIMEOUT=60
# Detector (v0.4): persistent stream reader + light filter + person detection
DETECT_FPS=4
PERSON_MODEL=/opt/seccam/models/yolox_s.onnx
PERSON_SCORE=0.5
PERSON_INPUT_SIZE=416
# Seconds of localized motion without a person that still start a recording (0 = people only)
MOTION_FALLBACK=8
