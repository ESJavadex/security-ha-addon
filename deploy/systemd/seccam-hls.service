[Unit]
Description=Seccam HLS server (:8080, CORS)
After=network-online.target

[Service]
Type=simple
User=seccamd
Group=seccamd
Environment=HLS_DIR=/var/lib/seccam/hls
ExecStart=/usr/bin/python3 /opt/seccam/ezviz/hls_server.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/seccam/hls
MemoryMax=100M

[Install]
WantedBy=multi-user.target
