[Unit]
Description=Seccam EZVIZ relay (camera -> HLS without 30 s gaps)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=seccamd
Group=seccamd
EnvironmentFile=/etc/seccam/ezviz.env
Environment=HLS_DIR=/var/lib/seccam/hls
Environment=EZVIZ_TOKEN_FILE=/var/lib/seccam/ezviz/session.json
Environment=EZVIZ_FEATURE_CODE_FILE=/var/lib/seccam/ezviz/feature_code
WorkingDirectory=/opt/seccam/ezviz
ExecStart=/usr/bin/python3 -u /opt/seccam/ezviz/stream_relay.py
Restart=always
# Recover fast from a wedge, but back off on repeated failures (auth problems
# must not hammer the EZVIZ API)
RestartSec=3
RestartSteps=5
RestartMaxDelaySec=300
# Pinged only while video flows; a hard hang gets the relay killed and restarted
WatchdogSec=90
NotifyAccess=main
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/seccam
UMask=0027
MemoryMax=400M
CPUWeight=120

[Install]
WantedBy=multi-user.target
