[Unit]
Description=Seccam motion/person detector and recorder
After=network-online.target remote-fs.target
Wants=network-online.target
# Keep retrying while the WD share is down instead of giving up
StartLimitIntervalSec=0

[Service]
Type=simple
User=seccamd
Group=seccamd
EnvironmentFile=/etc/seccam/seccam.env
WorkingDirectory=/opt/seccam/app
# Never start without the WD mounted: with an empty recordings dir the recorder
# would rewrite recordings.json without the existing entries.
ExecStartPre=/bin/sh -c 'ls /share/security_recordings >/dev/null 2>&1; mountpoint -q /share/security_recordings'
ExecStart=/usr/bin/python3 /opt/seccam/app/service.py
Restart=always
RestartSec=15
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/seccam /share/security_recordings
UMask=0022
MemoryMax=900M
CPUWeight=80

[Install]
WantedBy=multi-user.target
